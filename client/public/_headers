# ------------------------------------------------------------------------------
# 7. SENSITIVE / AUTHENTICATED / TRANSACTIONAL SPA ROUTES
# Direct navigation/refresh must never store cached private customer/admin HTML.
# ------------------------------------------------------------------------------
/admin
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
/track-order/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
/booking-confirmation
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

# ------------------------------------------------------------------------------
# 8. DYNAMIC API & BACKEND ENDPOINTS (CRITICAL: NEVER CACHED AT CDN EDGE)
# All real-time room availability, bookings, rates, payments, orders, and admin APIs.
# ------------------------------------------------------------------------------
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
