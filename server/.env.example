PORT=5000
MONGODB_URI=mongodb://localhost:27017/hotel_raama
JWT_SECRET=raama_super_secret_jwt_key_2026_production
NODE_ENV=development

# Admin Initial Credentials for Seeding
ADMIN_EMAIL=admin@hotelraama.com
ADMIN_PASSWORD=AdminRaama@2026

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret
# Explicit flag for allowing mock payment IDs (pay_mock_*) in dev/test only. Strictly rejected when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=false

# Email Delivery Configuration (Resend HTTPS API - Production Primary)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Hotel Raama Reservations <reservations@hotelraama.com>"
HOTEL_NOTIFICATION_EMAIL=hotelraama.hsn@gmail.com
HOTEL_WHATSAPP_NUMBER=917899511330

# Legacy Email Delivery Configuration (Nodemailer SMTP Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hotelraama.hsn@gmail.com
SMTP_PASSWORD=your_app_password_here

CLIENT_URL=http://localhost:5173
